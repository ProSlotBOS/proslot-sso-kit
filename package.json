{
  "name": "@proslotbosllc/sso-kit",
  "version": "1.2.0",
  "description": "Shared SSO and onboarding kit for ProSlot satellite sites — auth-code exchange, role resolution, and a config-driven onboarding step runner.",
  "license": "UNLICENSED",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "firebase": ">=10",
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "firebase": "^11.0.0",
    "react": "^19.0.0",
    "typescript": "^5.6.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ProSlotBOS/proslot-sso-kit.git"
  },
  "engines": {
    "node": ">=18"
  }
}
